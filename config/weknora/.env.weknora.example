# Обязательные переменные WeKnora (SPEC §13.2, §17.2). Рабочий файл — .env.weknora, в git не попадает.
# Язык всех генераций и ответов; перекрывает Accept-Language. Без него — китайский.
WEKNORA_LANGUAGE=ru-RU
# Язык интерфейса по умолчанию для новых браузеров.
DEFAULT_LOCALE=ru-RU
# Поиск: PostgreSQL + ParadeDB (ADR 0005).
RETRIEVE_DRIVER=postgres
# Регистрация выключена; вход только через OIDC (Keycloak).
DISABLE_REGISTRATION=true
# Исходящие запросы только по белому списку имён хостов.
SSRF_DNS_WHITELIST_ONLY=true
SSRF_WHITELIST=llm-chat,llm-utility,llm-vl,embed,rerank,corp-ext,data-gateway,keycloak
# Секреты задаются явно и не хранятся в git: JWT_SECRET, SYSTEM_AES_KEY, OIDC_*, GRPC_AUTH_TOKEN.
