# Скопируйте в deploy/compose/.env и передайте: docker compose --env-file deploy/compose/.env ...
# Значения ниже — только для локальной разработки.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-only-password
POSTGRES_DB=weknora
# Тестовая учётка WeKnora для ручной проверки до Keycloak (этап 1); создаётся регистрацией в UI или
# POST /api/v1/auth/register. Только для dev-стека.
WEKNORA_DEV_EMAIL=dev@corp.test
WEKNORA_DEV_PASSWORD=dev-only-Passw0rd
# mock-AD (Samba AD DC, домен CORP.LOCAL) и Keycloak (http://keycloak.localhost:8180, realm corp).
# Пользователи mock-AD — deploy/mock-ad/users.tsv, пароль у всех один.
MOCK_AD_ADMIN_PASSWORD=Dev-only-Admin1
MOCK_AD_USER_PASSWORD=dev-only-Passw0rd
MOCK_AD_BIND_PASSWORD=dev-only-Bind1
KC_ADMIN_PASSWORD=dev-only-admin
KC_WEKNORA_CLIENT_SECRET=dev-only-weknora-secret
# Статический токен MCP-сервиса data-gateway (заголовок Authorization: Bearer …).
DATA_GATEWAY_TOKEN=dev-only-data-gateway-token
